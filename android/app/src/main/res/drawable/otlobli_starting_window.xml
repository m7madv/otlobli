<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <!-- Android draws this window before MainActivity or the WebView exist.
         It is an exact local rendering of the app's own loading surface, so
         the native Otlobli shell can take over without a blank or a new look. -->
    <item android:gravity="fill" android:drawable="@drawable/otlobli_starting_screen" />
</layer-list>
