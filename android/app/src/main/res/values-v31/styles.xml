<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ requires the platform splash contract. The app-owned
         surface takes over as soon as MainActivity can draw. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/otlobli_starting_window</item>
        <item name="android:background">@drawable/otlobli_starting_window</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
