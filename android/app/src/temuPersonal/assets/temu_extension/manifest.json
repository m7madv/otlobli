{
  "manifest_version": 2,
  "name": "Otlobli Temu In-App Guard",
  "version": "1.3.14",
  "browser_specific_settings": {
    "gecko": {
      "id": "otlobli-temu@otlobli.app"
    }
  },
  "permissions": [
    "https://*.temu.com/*",
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.temu.com/*"],
      "js": ["content.js", "content-capture.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
