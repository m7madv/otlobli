# ─── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── WhatsApp Auth ───────────────────────────────────────────────────────────
# mock = OTP تجريبي (للتطوير)
# real = OTP حقيقي عبر Baileys (server-whatsapp)
VITE_WHATSAPP_AUTH_MODE=real

# رقم واتساب الدعم (بدون +)
VITE_SUPPORT_WHATSAPP_PHONE=963900000000

# ─── Render.com Services ─────────────────────────────────────────────────────
# بعد النشر على Render، ضع روابط الخدمتين هنا
VITE_WHATSAPP_API_URL=https://talabieh-whatsapp.onrender.com
VITE_SHEIN_SCRAPER_URL=https://talabieh-scraper.onrender.com

# ─── سعر الصرف الاحتياطي (يُستخدم إذا فشل جلبه من sp-today.com) ──────────
VITE_USD_TO_SYP_RATE=131.7

# ─── تسجيل الدخول عبر جوجل (v86) ─────────────────────────────────────────────
# مشروع Firebase otlobli-1ccf5 مضبوط بالكامل (SHA-1 + Google provider + OAuth clients).
# الإضافة المستخدمة: @capgo/capacitor-social-login (مثبّتة). المعرّف أدناه غير سرّي.
# فعّلها = true لإظهار زر "المتابعة عبر جوجل" في التطبيق، ثم أعد البناء والمزامنة.
VITE_GOOGLE_AUTH_ENABLED=true
# معرّف عميل الويب (Web OAuth client) لمشروع otlobli-1ccf5:
VITE_GOOGLE_WEB_CLIENT_ID=677396296147-o5q0rt5qk2rq0rqh714kuki7gabkdmcu.apps.googleusercontent.com
# معرّف OAuth من نوع iOS والمربوط بالحزمة com.otlobli.app:
VITE_GOOGLE_IOS_CLIENT_ID=

# ─── إشعارات Push (v86) ──────────────────────────────────────────────────────
# اتركها false لإبقاء التسجيل خاملاً. فعّلها = true بعد تثبيت
# @capacitor/push-notifications وإضافة google-services.json (أندرويد) / APNs (iOS).
VITE_PUSH_ENABLED=false

# ─── iOS SHEIN clean-room diagnostic IPA only ───────────────────────────────
# The v86.206 forensic branch defaults this on. Set false for any customer
# build; clean modes require iOS 17+ persistent WebKit profile isolation.
VITE_SHEIN_CLEAN_ROOM_DIAGNOSTICS=false
