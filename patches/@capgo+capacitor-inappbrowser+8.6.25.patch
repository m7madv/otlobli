+    private func otlobliNativeBackDestination(in webView: WKWebView) -> WKBackForwardListItem? {
+        let currentURL = webView.url
+        let currentIsProduct = currentURL?.path.range(of: "-p-", options: .caseInsensitive) != nil
+        return webView.backForwardList.backList.reversed().first { item in
+            let candidate = item.url
+            guard ["http", "https"].contains(candidate.scheme?.lowercased() ?? ""),
+                  let host = candidate.host?.lowercased(),
+                  host == "shein.com" || host.hasSuffix(".shein.com"),
+                  candidate.absoluteString != currentURL?.absoluteString else { return false }
+            let lower = candidate.absoluteString.lowercased()
+            if lower.contains("/challenge") || lower.contains("/captcha") || lower.contains("/verification") { return false }
+            if currentIsProduct && candidate.path == currentURL?.path { return false }
+            return true
+        }
+    }
