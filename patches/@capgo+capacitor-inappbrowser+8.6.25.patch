+    private long otlobliDocumentGenerationTimestamp(String generation) {
+        if (TextUtils.isEmpty(generation)) return 0L;
+        String prefix = generation.split("-", 2)[0];
+        if (!prefix.matches("[0-9A-Za-z]+")) return 0L;
+        try {
+            return Long.parseLong(prefix, 36);
+        } catch (NumberFormatException ignored) {
+            return 0L;
+        }
+    }
+
+    private boolean otlobliReadyDocumentCanReleaseHumanChallenge(String generation) {
+        if (TextUtils.isEmpty(generation)) return false;
+        boolean sameResolvedDocument = !TextUtils.isEmpty(otlobliHumanChallengeDocumentGeneration) &&
+            generation.equals(otlobliHumanChallengeDocumentGeneration) &&
+            otlobliHumanChallengeResolutionReported;
+        long readyTimestamp = otlobliDocumentGenerationTimestamp(generation);
+        long challengeTimestamp = otlobliDocumentGenerationTimestamp(otlobliHumanChallengeDocumentGeneration);
+        boolean freshDocument = readyTimestamp > 0L && challengeTimestamp > 0L && readyTimestamp > challengeTimestamp;
+        boolean resolvedUnknownDocument = TextUtils.isEmpty(otlobliHumanChallengeDocumentGeneration) &&
+            otlobliHumanChallengeResolutionReported;
+        return sameResolvedDocument || freshDocument || resolvedUnknownDocument;
+    }
+
+    private boolean otlobliIsTrustedChallengeMessageSource(Uri sourceOrigin, boolean isMainFrame) {
+        if (!isMainFrame) return false;
+        try {
+            Uri current = Uri.parse(otlobliCurrentTopLevelUrl);
+            String currentHost = current.getHost();
+            boolean currentStoreHost = otlobliIsTemuHost(currentHost) || otlobliIsSheinHost(currentHost);
+            if (!"https".equalsIgnoreCase(current.getScheme()) || !currentStoreHost) return false;
+            // addJavascriptInterface cannot prove which frame invoked it. Only
+            // the WebMessage listener supplies an origin plus main-frame bit,
+            // so an origin-less fallback must never change native gate state.
+            if (sourceOrigin == null) return false;
+            return "https".equalsIgnoreCase(sourceOrigin.getScheme()) &&
+                TextUtils.equals(currentHost == null ? "" : currentHost.toLowerCase(Locale.ROOT),
+                    sourceOrigin.getHost() == null ? "" : sourceOrigin.getHost().toLowerCase(Locale.ROOT));
+        } catch (Exception ignored) {
+            return false;
+        }
+    }
+
+    private boolean otlobliSameTopLevelDocument(Uri first, Uri second) {
+        if (first == null || second == null) return false;
+        return TextUtils.equals(first.getScheme(), second.getScheme()) &&
+            TextUtils.equals(first.getHost(), second.getHost()) &&
+            TextUtils.equals(first.getPath(), second.getPath()) &&
+            TextUtils.equals(first.getQuery(), second.getQuery());
+    }
+
+    private boolean otlobliIsHumanChallengeUrl(Uri uri) {
+        if (uri == null) return false;
+        String path = uri.getPath() == null ? "/" : uri.getPath().toLowerCase(Locale.ROOT);
+        String route = path + (uri.getQuery() == null ? "" : "?" + uri.getQuery()) +
+            (uri.getFragment() == null ? "" : "#" + uri.getFragment());
+        return otlobliRouteMatches(path, "/(?:cdn-cgi|challenge|captcha|verify|verification|bgn[_-]?verification|security|robot|risk|anti[-_]?bot|human)(?:[/?#.-]|$)") ||
+            otlobliRouteMatches(route, "(?:^|[?&#])(?:captcha|challenge|verification|bgn[_-]?verification|security_token|risk|robot|anti[-_]?bot|human)=");
+    }
+
+    private boolean otlobliIsTrustedTemuReady(JSONObject detail) {
+        if (!otlobliIsTemuSession()) return false;
+        String type = detail.optString("type", "");
+        if (!("temuPublicReady".equals(type) || "temuProductVisible".equals(type))) return false;
+        if (TextUtils.isEmpty(detail.optString("documentGeneration", ""))) return false;
+        try {
+            Uri readyUrl = Uri.parse(detail.optString("url", ""));
+            Uri currentUrl = Uri.parse(otlobliCurrentTopLevelUrl);
+            return "https".equalsIgnoreCase(readyUrl.getScheme()) && otlobliIsTemuHost(readyUrl.getHost()) &&
+                !otlobliIsHumanChallengeUrl(readyUrl) && !otlobliIsHumanChallengeUrl(currentUrl) &&
+                otlobliSameTopLevelDocument(currentUrl, readyUrl);
+        } catch (Exception ignored) {
+            return false;
+        }
+    }
+
+    private boolean otlobliIsTrustedSheinCoordinatorReady(JSONObject detail) {
+        if (!otlobliIsSheinSession()) return false;
+        if (otlobliIsHumanChallengeUrl(Uri.parse(otlobliCurrentTopLevelUrl))) return false;
+        String type = detail.optString("type", "");
+        if (!("sheinSaudiReady".equals(type) || "sheinPageInteractive".equals(type) || "sheinCoordinatorState".equals(type))) {
+            return false;
+        }
+        JSONObject coordinator = detail.optJSONObject("coordinator");
+        if (coordinator == null || TextUtils.isEmpty(coordinator.optString("documentGeneration", ""))) return false;
+        if (!coordinator.optBoolean("interactive", false)) return false;
+        if (!"verified".equals(coordinator.optString("policyState", ""))) return false;
+        if (!"ready".equals(coordinator.optString("captureState", ""))) return false;
+        if (!"matching".equals(coordinator.optString("countryState", "")) ||
+            !"matching".equals(coordinator.optString("regionState", "")) ||
+            !"matching".equals(coordinator.optString("currencyState", "")) ||
+            !"matching".equals(coordinator.optString("languageState", ""))) return false;
+        String loginState = coordinator.optString("loginState", "unknown");
+        if (!("not-required".equals(loginState) || "blocked".equals(loginState))) return false;
+        String humanState = coordinator.optString("humanVerificationState", "required");
+        return "none".equals(humanState) || "resolved".equals(humanState);
+    }
