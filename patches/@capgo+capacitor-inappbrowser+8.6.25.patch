+    private boolean isOtlobliOfflineError(WebResourceError error) {
+        if (error == null) return false;
+        int code = error.getErrorCode();
+        if (
+            code == WebViewClient.ERROR_HOST_LOOKUP ||
+            code == WebViewClient.ERROR_CONNECT ||
+            code == WebViewClient.ERROR_TIMEOUT ||
+            code == WebViewClient.ERROR_IO
+        ) {
+            return true;
+        }
+        CharSequence rawDescription = error.getDescription();
+        String description = rawDescription == null ? "" : rawDescription.toString().toLowerCase(Locale.ROOT);
+        return (
+            description.contains("internet") ||
+            description.contains("network") ||
+            description.contains("disconnected")
+        );
+    }
