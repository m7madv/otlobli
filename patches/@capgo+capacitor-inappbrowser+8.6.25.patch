+    private func handleOtlobliLoadingCoverMessage(_ messageBody: [String: Any]) {
+        guard let detail = messageBody["detail"] as? [String: Any],
+              let type = detail["type"] as? String else {
+            return
+        }
+        // Back belongs to native navigation even when this store does not use
+        // the optional loading cover (Temu). Hide it for every verification
+        // surface before applying cover-specific behavior below.
+        if type == "humanCheck" || type == "humanCheckResolved" {
+            otlobliNativeBackButton?.isHidden = true
+        }
+        guard otlobliLoadingCoverEnabled else { return }
+        switch type {
+        case "sheinSaudiRepairStart":
+            cancelOtlobliChallengeReveal()
+            otlobliLoadingCoverMessage = "جاري ضبط منطقة المتجر…"
+            otlobliLoadingCoverLabel?.text = otlobliLoadingCoverMessage
+            showOtlobliLoadingCover()
+        case "humanCheck", "humanCheckResolved":
+            // Verification is genuine store UI and must be visible/touchable
+            // immediately. A six-second native cover made the challenge look
+            // frozen and could hide its first interaction entirely on iPhone.
+            cancelOtlobliChallengeReveal()
+            hideOtlobliLoadingCover()
+        case "sheinSaudiReady", "sheinPageInteractive", "sheinBlocked":
+            cancelOtlobliChallengeReveal()
+            hideOtlobliLoadingCover()
+        default:
+            break
+        }
+    }
+
+    private func otlobliStoreHost(for message: WKScriptMessage) -> String? {
+        guard message.frameInfo.isMainFrame,
+              message.webView === webView,
+              let host = (message.webView?.url ?? message.frameInfo.request.url)?.host?.lowercased(),
+              (host == "temu.com" || host.hasSuffix(".temu.com") ||
+                host == "shein.com" || host.hasSuffix(".shein.com")) else {
+            return nil
+        }
+        return host
+    }
+
+    private func otlobliDocumentGenerationTimestamp(_ generation: String) -> Int64 {
+        guard let prefix = generation.split(separator: "-", maxSplits: 1).first,
+              !prefix.isEmpty else { return 0 }
+        return Int64(String(prefix), radix: 36) ?? 0
+    }
+
+    private func otlobliReadyGenerationCanRelease(_ generation: String) -> Bool {
+        guard !generation.isEmpty else { return false }
+        if otlobliHumanChallengeDocumentGeneration.isEmpty {
+            if otlobliHumanChallengeResolutionReported { return true }
+            return otlobliDocumentGenerationTimestamp(generation) >
+                otlobliHumanChallengeStartedAtMilliseconds
+        }
+        if generation == otlobliHumanChallengeDocumentGeneration {
+            return otlobliHumanChallengeResolutionReported
+        }
+        return otlobliDocumentGenerationTimestamp(generation) >
+            otlobliDocumentGenerationTimestamp(otlobliHumanChallengeDocumentGeneration)
+    }
+
+    private func otlobliIsHumanChallengeURL(_ url: URL?) -> Bool {
+        guard let raw = url?.absoluteString.lowercased(), !raw.isEmpty else { return false }
+        return ["/challenge", "/captcha", "/verify", "/verification", "/bgn_verification",
+                "/bgn-verification", "/security", "/robot", "/risk/", "/anti-bot", "/human",
+                "?captcha=", "&captcha=", "?challenge=", "&challenge=", "?verification=",
+                "&verification=", "?bgn_verification=", "&bgn_verification="].contains { raw.contains($0) }
+    }
+
+    private func otlobliSameTopLevelDocument(_ first: URL?, _ second: URL?) -> Bool {
+        guard let first, let second else { return false }
+        return first.scheme?.lowercased() == second.scheme?.lowercased() &&
+            first.host?.lowercased() == second.host?.lowercased() &&
+            first.path == second.path && first.query == second.query
+    }
+
+    private func otlobliSheinCoordinatorReady(_ detail: [String: Any]) -> Bool {
+        guard let coordinator = detail["coordinator"] as? [String: Any] else { return false }
+        let login = coordinator["loginState"] as? String ?? "unknown"
+        let human = coordinator["humanVerificationState"] as? String ?? "required"
+        return (coordinator["countryState"] as? String) == "matching" &&
+            (coordinator["regionState"] as? String) == "matching" &&
+            (coordinator["currencyState"] as? String) == "matching" &&
+            (coordinator["languageState"] as? String) == "matching" &&
+            (login == "not-required" || login == "blocked") &&
+            (human == "none" || human == "resolved") &&
+            (coordinator["policyState"] as? String) == "verified" &&
+            (coordinator["captureState"] as? String) == "ready" &&
+            (coordinator["interactive"] as? Bool) == true
+    }
+
+    private func setOtlobliHumanChallengeActive(_ active: Bool) {
+        guard otlobliHumanChallengeActive != active else {
+            if active { updateNavigationGestures() }
+            return
+        }
+        if active {
+            otlobliNativeBackVisibleBeforeChallenge = !(otlobliNativeBackButton?.isHidden ?? true)
+        }
+        otlobliHumanChallengeActive = active
+        updateNavigationGestures()
+        backBarButtonItem.isEnabled = !active && (webView?.canGoBack ?? false)
+        if active {
+            dismissOtlobliStoreSwitchHint()
+            otlobliNativeBackButton?.isEnabled = false
+            otlobliNativeBackButton?.isUserInteractionEnabled = false
+            otlobliNativeBackButton?.isHidden = true
+        } else {
+            let restoreNativeBack = otlobliNativeBackVisibleBeforeChallenge || otlobliNativeBackRequestedVisible
+            otlobliNativeBackRequestedVisible = restoreNativeBack
+            otlobliNativeBackVisibleBeforeChallenge = false
+            otlobliNativeBackButton?.isEnabled = restoreNativeBack
+            otlobliNativeBackButton?.isUserInteractionEnabled = restoreNativeBack
+            otlobliNativeBackButton?.isHidden = !restoreNativeBack
+            scheduleOtlobliStoreSwitchDiscoveryHint()
+        }
+    }
