+    private func startOtlobliPathMonitor() {
+        guard otlobliPathMonitor == nil else { return }
+        let monitor = NWPathMonitor()
+        monitor.pathUpdateHandler = { [weak self] path in
+            guard path.status == .satisfied else { return }
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.35) {
+                self?.retryOtlobliOfflinePage(automatic: true)
+            }
+        }
+        otlobliPathMonitor = monitor
+        monitor.start(queue: otlobliPathMonitorQueue)
+    }
+
+    private func stopOtlobliPathMonitor() {
+        otlobliPathMonitor?.cancel()
+        otlobliPathMonitor = nil
+    }
