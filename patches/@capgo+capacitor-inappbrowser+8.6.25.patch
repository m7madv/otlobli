+// Diagnostic IPA only. The ring survives a force-quit so the report can be
+// copied after the first frozen frame, without a network request or a timer.
+private enum OtlobliFreezeDiagnostics {
+    private static let storageKey = "otlobli.shein.freeze.diagnostics.v1"
+    private static let limit = 180
+
+    static func record(_ event: String, fields: [String: Any] = [:]) {
+        var item = fields
+        item["event"] = event
+        item["at"] = Int(Date().timeIntervalSince1970 * 1000)
+        var records = UserDefaults.standard.array(forKey: storageKey) as? [[String: Any]] ?? []
+        if records.count >= limit {
+            records.removeFirst(records.count - limit + 1)
+        }
+        records.append(item)
+        UserDefaults.standard.set(records, forKey: storageKey)
+    }
+
+    static func report() -> String {
+        let records = UserDefaults.standard.array(forKey: storageKey) as? [[String: Any]] ?? []
+        guard JSONSerialization.isValidJSONObject(records),
+              let data = try? JSONSerialization.data(withJSONObject: records, options: [.prettyPrinted, .sortedKeys]),
+              let json = String(data: data, encoding: .utf8) else {
+            return "OTLOBLI_SHEIN_FREEZE_DIAGNOSTIC\nreport encoding failed"
+        }
+        return "OTLOBLI_SHEIN_FREEZE_DIAGNOSTIC\n" + json
+    }
+}

