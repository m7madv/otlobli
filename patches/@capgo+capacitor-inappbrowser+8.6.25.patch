+    private void otlobliRecoverBlockedSheinRouteAfterChallenge() {
+        mainHandler.post(() -> {
+            if (_webView == null || otlobliHumanChallengeNavigationLocked || !otlobliIsSheinSession()) return;
+            String currentUrl = _webView.getUrl();
+            if (otlobliIsBlockedSheinRoute(otlobliClassifySheinRoute(currentUrl))) {
+                otlobliRecoverBlockedSheinHistoryRoute(_webView, currentUrl);
+            }
+        });
+    }
+
+    private void handleOtlobliHumanChallengeMessage(String message, Uri sourceOrigin, boolean isMainFrame) {
+        try {
+            if (!otlobliIsTrustedChallengeMessageSource(sourceOrigin, isMainFrame)) return;
+            JSONObject payload = new JSONObject(message);
+            JSONObject detail = payload.optJSONObject("detail");
+            if (detail == null) return;
+            String type = detail.optString("type", "");
+            if ("humanCheck".equals(type)) {
+                if (!(otlobliIsSheinSession() || otlobliIsTemuSession())) return;
+                otlobliHumanChallengeNavigationLocked = true;
+                otlobliRecoveringBlockedSheinUrl = "";
+                otlobliHumanChallengeResolutionReported = false;
+                otlobliHumanChallengeDocumentGeneration = detail.optString("documentGeneration", "");
+                mainHandler.post(() -> {
+                    dismissOtlobliStoreSwitchHint();
+                    updateNavigationButtonsState();
+                });
+                return;
+            }
+            if ("humanCheckResolved".equals(type)) {
+                if (!otlobliHumanChallengeNavigationLocked) return;
+                String resolvedGeneration = detail.optString("documentGeneration", "");
+                if (TextUtils.isEmpty(resolvedGeneration) ||
+                    TextUtils.isEmpty(otlobliHumanChallengeDocumentGeneration) ||
+                    resolvedGeneration.equals(otlobliHumanChallengeDocumentGeneration)) {
+                    // Status only. A solved widget can disappear before the
+                    // provider commits its token, so Back remains locked.
+                    otlobliHumanChallengeResolutionReported = true;
+                }
+                return;
+            }
+            if (!otlobliHumanChallengeNavigationLocked) return;
+
+            String readyGeneration = "";
+            if (otlobliIsTrustedTemuReady(detail)) {
+                readyGeneration = detail.optString("documentGeneration", "");
+            } else if (otlobliIsTrustedSheinCoordinatorReady(detail)) {
+                readyGeneration = detail.optJSONObject("coordinator").optString("documentGeneration", "");
+            }
+            if (otlobliReadyDocumentCanReleaseHumanChallenge(readyGeneration)) {
+                otlobliClearHumanChallengeNavigationGate();
+                otlobliRecoverBlockedSheinRouteAfterChallenge();
+                mainHandler.post(this::scheduleOtlobliStoreSwitchDiscoveryHint);
+            }
+        } catch (JSONException ignored) {
+            // Only structured bridge messages may change native navigation state.
+        }
+    }
+
+    private boolean otlobliRouteMatches(String value, String pattern) {
+        return value != null && Pattern.compile(pattern, Pattern.CASE_INSENSITIVE).matcher(value).find();
+    }
+
+    private String otlobliClassifySheinRoute(String rawUrl) {
+        try {
+            Uri uri = Uri.parse(rawUrl);
+            String scheme = uri.getScheme() == null ? "" : uri.getScheme().toLowerCase(Locale.ROOT);
+            if (!"http".equals(scheme) && !"https".equals(scheme)) return "unknown";
+            if (!otlobliIsSheinHost(uri.getHost())) return "external";
+            String path = uri.getPath() == null ? "/" : uri.getPath().replaceAll("/{2,}", "/").toLowerCase(Locale.ROOT);
+            String route = path + (uri.getQuery() == null ? "" : "?" + uri.getQuery()) + (uri.getFragment() == null ? "" : "#" + uri.getFragment());
+            if (otlobliRouteMatches(path, "/(?:cdn-cgi|challenge|captcha|verify|verification|bgn[_-]?verification|security|robot|risk|anti[-_]?bot|human)(?:[/?#.-]|$)") ||
+                otlobliRouteMatches(route, "(?:^|[?&#])(?:captcha|challenge|verification|bgn[_-]?verification|security_token|risk|robot|anti[-_]?bot|human)=")) return "human-verification";
+            if (otlobliRouteMatches(path, "/(?:user/)?(?:login|signin|sign-in|auth(?:/login)?)(?:[/?#.-]|$)")) return "blocked-login";
+            if (otlobliRouteMatches(path, "/(?:user/)?(?:register|signup|sign-up|join)(?:[/?#.-]|$)")) return "blocked-signup";
+            if (otlobliRouteMatches(path, "/(?:user|account|profile|my-account|member|orders?)(?:[/?#.-]|$)")) return "blocked-account";
+            if (otlobliRouteMatches(path, "/(?:country|countries|ship-to|shipping-country)(?:[/?#.-]|$)")) return "blocked-country";
+            if (otlobliRouteMatches(path, "/(?:region|location|shipping-address|address-book)(?:[/?#.-]|$)")) return "blocked-region";
+            if (otlobliRouteMatches(path, "/(?:language|languages|locale)(?:[/?#.-]|$)")) return "blocked-language";
+            if (otlobliRouteMatches(path, "/(?:currency|currencies)(?:[/?#.-]|$)")) return "blocked-currency";
+            if (otlobliRouteMatches(path, "/(?:cart|bag|checkout|order-confirm|payment)(?:[/?#.-]|$)")) return "blocked-checkout";
+            if (otlobliRouteMatches(path, "(?:-p-[0-9]+|/product/|/goods/|/item/)") ||
+                otlobliRouteMatches(route, "[?&](?:goods_id|goodsid|product_id|productid|mallcode|skc)=")) return "product";
+            if (otlobliRouteMatches(path, "/(?:search|search-result)(?:[/?#.-]|$)") || uri.getQueryParameter("search") != null) return "search";
+            if (otlobliRouteMatches(path, "/(?:category|categories|collection|collections|campaign|daily|women|men|kids|curve|home-living)(?:[/?#.-]|$)")) return "category";
+            String normalized = path.replaceAll("^/+|/+$", "");
+            if (normalized.isEmpty() || normalized.matches("(?i)^[a-z]{2}(?:-[a-z]{2})?$")) return "home";
+            return "allowed-public";
+        } catch (Exception ignored) {
+            return "unknown";
+        }
+    }
+
+    private boolean otlobliIsBlockedSheinRoute(String routeClass) {
+        return routeClass != null && routeClass.startsWith("blocked-");
+    }
+
+    private boolean otlobliIsSafePublicSheinRoute(String routeClass) {
+        return routeClass != null && !"external".equals(routeClass) && !"unknown".equals(routeClass) &&
+            !"human-verification".equals(routeClass) && !otlobliIsBlockedSheinRoute(routeClass);
+    }
+
+    private void otlobliEmitSheinMessage(String type, String key, String value) {
+        if (_options == null || _options.getCallbacks() == null) return;
+        try {
+            JSONObject detail = new JSONObject();
+            detail.put("type", type);
+            detail.put("version", OTLOBLI_SHEIN_POLICY_VERSION);
+            detail.put(key, value);
+            JSONObject payload = new JSONObject();
+            payload.put("detail", detail);
+            _options.getCallbacks().javascriptCallback(payload.toString());
+        } catch (JSONException ignored) {}
+    }
+
+    private void otlobliEmitOpeningPhase(String phase) {
+        if (otlobliIsSheinSession()) otlobliEmitSheinMessage("sheinOpeningPhase", "phase", phase);
+    }
+
+    private void otlobliEmitBlockedSheinRoute(String routeClass) {
+        long now = System.currentTimeMillis();
+        if (routeClass.equals(otlobliLastBlockedSheinRoute) && now - otlobliLastBlockedSheinRouteAt < 1000L) return;
+        otlobliLastBlockedSheinRoute = routeClass;
+        otlobliLastBlockedSheinRouteAt = now;
+        otlobliEmitSheinMessage("sheinPolicyRouteBlocked", "routeClass", routeClass);
+    }
+
+    // Network navigations are rejected by shouldOverrideUrlLoading. SHEIN can
+    // also enter /user/login through same-document History API routing, which
+    // is reported only by doUpdateVisitedHistory. Reuse that callback and
+    // perform one native Back action, matching the site's own Back control. A
+    // single bounded check falls back to Home if Back did not actually leave
+    // the blocked route. No persistent timer, observer or DOM scan is added.
+    private boolean otlobliRecoverBlockedSheinHistoryRoute(WebView view, String rawUrl) {
+        if (view == null || otlobliHumanChallengeNavigationLocked || !otlobliIsSheinSession()) return false;
+        String url = rawUrl == null ? "" : rawUrl;
+        String routeClass = otlobliClassifySheinRoute(url);
+        if (!otlobliIsBlockedSheinRoute(routeClass)) {
+            otlobliRecoveringBlockedSheinUrl = "";
+            if (otlobliIsSafePublicSheinRoute(routeClass)) otlobliLastSafeSheinUrl = url;
+            return false;
+        }
+
+        otlobliEmitBlockedSheinRoute(routeClass);
+        if (url.equals(otlobliRecoveringBlockedSheinUrl)) return true;
+
+        otlobliRecoveringBlockedSheinUrl = url;
+        view.post(() -> {
+            if (_webView != view || otlobliHumanChallengeNavigationLocked) return;
+            if (view.canGoBack()) {
+                view.goBack();
+                view.postDelayed(() -> {
+                    if (_webView != view || otlobliHumanChallengeNavigationLocked ||
+                        !url.equals(otlobliRecoveringBlockedSheinUrl)) return;
+                    String currentUrl = view.getUrl();
+                    if (otlobliIsBlockedSheinRoute(otlobliClassifySheinRoute(currentUrl))) {
+                        view.loadUrl("https://m.shein.com/ar/");
+                    }
+                }, 200L);
+            } else {
+                view.loadUrl("https://m.shein.com/ar/");
+            }
+        });
+        return true;
+    }
+
+    private boolean otlobliIsOutboundFromBlockedSheinRoute(String destinationUrl) {
+        if (otlobliHumanChallengeNavigationLocked || !otlobliIsSheinSession() ||
+            !otlobliIsBlockedSheinRoute(otlobliClassifySheinRoute(otlobliCurrentTopLevelUrl))) return false;
+        String destinationRoute = otlobliClassifySheinRoute(destinationUrl);
+        return "external".equals(destinationRoute) || "unknown".equals(destinationRoute);
+    }
+
+    private void otlobliNavigateHost(String target) {
+        dismissOtlobliStoreSwitchHint();
+        if (otlobliHumanChallengeNavigationLocked) {
+            Log.w("InAppBrowser", "Host navigation blocked during human verification");
+            return;
+        }
+        if (!isJavaScriptControlAllowed()) {
+            Log.w("InAppBrowser", "Host navigation blocked: allowWebViewJsVisibilityControl is false");
+            return;
+        }
+        if (activity == null) {
+            Log.e("InAppBrowser", "Cannot navigate host - activity is null");
+            return;
+        }
+
+        final String route;
+        switch (target == null ? "" : target) {
+            case "store-select":
+                if (!isOtlobliNativeNavigationEnabled()) {
+                    Log.w("InAppBrowser", "Ignoring native Otlobli route without its scoped option");
+                    return;
+                }
+                route = target;
+                break;
+            case "orders":
+            case "cart":
+            case "profile":
+                route = target;
+                break;
+            default:
+                Log.w("InAppBrowser", "Ignoring unsupported host route");
+                return;
+        }
+
+        activity.runOnUiThread(() -> {
+            if (capacitorWebView == null) {
+                setHidden(true);
+                return;
+            }
+            AtomicBoolean revealFinished = new AtomicBoolean(false);
+            Runnable revealHost = () -> {
+                if (revealFinished.compareAndSet(false, true)) setHidden(true);
+            };
+            String script =
+                "window.dispatchEvent(new CustomEvent('otlobli:nativeNavigate',{detail:" +
+                JSONObject.quote(route) +
+                "}));";
+            capacitorWebView.evaluateJavascript(script, ignored -> revealHost.run());
+            capacitorWebView.postDelayed(revealHost, 120L);
+        });
+    }
