+    private func republishOtlobliNativeBackState(in webView: WKWebView) {
+        guard !otlobliHumanChallengeActive else { return }
+        // A real navigation hides the native control in didStart. Temu may
+        // restore Home from its own cache without producing a later JS state
+        // change, so ask the completed document for its current state once.
+        // This is event-driven and does not add polling, retries or DOM scans.
+        webView.evaluateJavaScript(
+            "window.__otlobliNativeBackState='';if(typeof ensureBackButton==='function')ensureBackButton();",
+            completionHandler: nil
+        )
+    }
