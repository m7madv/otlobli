+    private void registerOtlobliNetworkCallback() {
+        if (otlobliNetworkCallbackRegistered || Build.VERSION.SDK_INT < Build.VERSION_CODES.LOLLIPOP) return;
+        try {
+            otlobliConnectivityManager = (ConnectivityManager) getContext().getSystemService(Context.CONNECTIVITY_SERVICE);
+            if (otlobliConnectivityManager == null) return;
+            NetworkRequest request = new NetworkRequest.Builder()
+                .addCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+                .build();
+            otlobliConnectivityManager.registerNetworkCallback(request, otlobliNetworkCallback);
+            otlobliNetworkCallbackRegistered = true;
+        } catch (RuntimeException error) {
+            Log.w("InAppBrowser", "Could not monitor Otlobli offline recovery", error);
+        }
+    }
+
+    private void unregisterOtlobliNetworkCallback() {
+        if (!otlobliNetworkCallbackRegistered || otlobliConnectivityManager == null) return;
+        try {
+            otlobliConnectivityManager.unregisterNetworkCallback(otlobliNetworkCallback);
+        } catch (RuntimeException ignored) {
+            // The callback may already be gone when Android tears down the dialog.
+        }
+        otlobliNetworkCallbackRegistered = false;
+        otlobliConnectivityManager = null;
+    }
