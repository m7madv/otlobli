+
+    // otlobli: Clears the iPhone16/iOS27 "frozen still frame" that appears when
+    // the app returns from the background. Root cause: iOS 27 aggressively
+    // reclaims a backgrounded WKWebView's GPU/render-server resources, and on
+    // resume it does not always reattach the remote layer tree - so the last
+    // painted frame stays on screen while the page is fully alive underneath
+    // (taps route, sections open once tapped). An old iPhone 6 on iOS 12 never
+    // does this reclaim, which is why it never freezes. A 1pt frame/scroll nudge
+    // (the previous attempt) does NOT fix it: setNeedsLayout only re-lays out
+    // UIKit and never forces the remote layer tree to rebuild.
+    //
+    // The ONLY reliable fix is to remove the WKWebView from the render tree and
+    // re-add it - that makes WebKit's separate render process tear down and
+    // rebuild the remote layer tree. This is EXACTLY what the user's manual
+    // "switch to Temu and come back" does: setHiddenState re-attaches via
+    // attachWebViewToController on the way back. We replicate that attach here
+    // (same Auto Layout constraints) and preserve scroll offset so nothing else
+    // about the page changes. A ~1 frame blank is imperceptible next to a
+    // permanent freeze.
+    func otlobliForceRecompose() {
+        let now = Date().timeIntervalSince1970
+        if now - otlobliLastRecomposeAt < 1.0 { return }
+        otlobliLastRecomposeAt = now
+        DispatchQueue.main.async { [weak self] in
+            guard let self = self,
+                  UIApplication.shared.applicationState == .active,
+                  self.isViewLoaded,
+                  let webView = self.webView,
+                  webView.superview === self.view,
+                  webView.bounds.height > 2 else {
+                return
+            }
+
+            let offset = webView.scrollView.contentOffset
+
+            // Detach from + reattach to the render tree (forces layer rebuild).
+            webView.removeFromSuperview()
+            webView.translatesAutoresizingMaskIntoConstraints = false
+            self.view.addSubview(webView)
+
+            let bottomAnchor = self.enabledSafeBottomMargin
+                ? self.view.safeAreaLayoutGuide.bottomAnchor
+                : self.view.bottomAnchor
+            let topAnchor = self.enabledSafeTopMargin
+                ? self.view.safeAreaLayoutGuide.topAnchor
+                : self.view.topAnchor
+
+            NSLayoutConstraint.activate([
+                webView.topAnchor.constraint(equalTo: topAnchor),
+                webView.leadingAnchor.constraint(equalTo: self.view.leadingAnchor),
+                webView.trailingAnchor.constraint(equalTo: self.view.trailingAnchor),
+                webView.bottomAnchor.constraint(equalTo: bottomAnchor)
+            ])
+
+            webView.alpha = 1
+            webView.isOpaque = true
+            webView.isUserInteractionEnabled = true
+
+            self.view.setNeedsLayout()
+            self.view.layoutIfNeeded()
+            webView.scrollView.setContentOffset(offset, animated: false)
+            webView.evaluateJavaScript("window.dispatchEvent(new Event('resize'));", completionHandler: nil)
+        }
+    }
