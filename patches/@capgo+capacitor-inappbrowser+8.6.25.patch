+    private func isOtlobliOfflineError(_ error: Error) -> Bool {
+        let nsError = error as NSError
+        guard nsError.domain == NSURLErrorDomain else { return false }
+        return nsError.code == NSURLErrorNotConnectedToInternet
+    }
+
+    private func otlobliFailingURL(from error: Error, webView: WKWebView) -> URL? {
+        let nsError = error as NSError
+        if let url = nsError.userInfo[NSURLErrorFailingURLErrorKey] as? URL {
+            return url
+        }
+        if let value = nsError.userInfo[NSURLErrorFailingURLStringErrorKey] as? String,
+           let url = URL(string: value) {
+            return url
+        }
+        return webView.url ?? self.url
+    }
