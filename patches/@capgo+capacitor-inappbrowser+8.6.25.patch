+                case HOME:
+                    path.moveTo(4f, 11.5f);
+                    path.lineTo(12f, 4f);
+                    path.lineTo(20f, 11.5f);
+                    path.moveTo(6f, 10f);
+                    path.lineTo(6f, 19f);
+                    path.lineTo(18f, 19f);
+                    path.lineTo(18f, 10f);
+                    path.moveTo(10f, 19f);
+                    path.lineTo(10f, 14f);
+                    path.lineTo(14f, 14f);
+                    path.lineTo(14f, 19f);
+                    canvas.drawPath(path, paint);
+                    break;
+                case ORDERS:
+                    canvas.drawRoundRect(4f, 7f, 20f, 20f, 1.3f, 1.3f, paint);
+                    path.moveTo(4f, 7f);
+                    path.lineTo(12f, 3f);
+                    path.lineTo(20f, 7f);
+                    path.moveTo(12f, 11f);
+                    path.lineTo(12f, 20f);
+                    canvas.drawPath(path, paint);
+                    break;
+                case CART:
+                    canvas.drawCircle(9f, 20f, 1.3f, paint);
+                    canvas.drawCircle(18f, 20f, 1.3f, paint);
+                    path.moveTo(3f, 4f);
+                    path.lineTo(5f, 4f);
+                    path.lineTo(7.2f, 15.5f);
+                    path.cubicTo(7.4f, 16.5f, 8.2f, 17.1f, 9.2f, 17.1f);
+                    path.lineTo(17.8f, 17.1f);
+                    path.cubicTo(18.8f, 17.1f, 19.6f, 16.5f, 19.8f, 15.5f);
+                    path.lineTo(21f, 8f);
+                    path.lineTo(6f, 8f);
+                    canvas.drawPath(path, paint);
+                    break;
+                default:
+                    canvas.drawCircle(12f, 8f, 3.6f, paint);
+                    path.moveTo(5f, 20f);
+                    path.cubicTo(5f, 16.2f, 8.1f, 13.6f, 12f, 13.6f);
+                    path.cubicTo(15.9f, 13.6f, 19f, 16.2f, 19f, 20f);
+                    canvas.drawPath(path, paint);
+                    break;
+            }
+            canvas.restore();
+        }
+    }
