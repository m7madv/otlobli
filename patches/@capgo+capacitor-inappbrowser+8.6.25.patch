+    private void otlobliEmitSheinMessage(String type, String key, String value) {
+        if (_options == null || _options.getCallbacks() == null) return;
+        try {
+            JSONObject detail = new JSONObject();
+            detail.put("type", type);
+            detail.put("version", OTLOBLI_SHEIN_POLICY_VERSION);
+            detail.put(key, value);
+            JSONObject payload = new JSONObject();
+            payload.put("detail", detail);
+            _options.getCallbacks().javascriptCallback(payload.toString());
+        } catch (JSONException ignored) {}
+    }
