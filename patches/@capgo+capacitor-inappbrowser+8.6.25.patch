+    private void handleOtlobliHomeNavigationActivation() {
+        if (otlobliHumanChallengeNavigationLocked) {
+            dismissOtlobliStoreSwitchHint();
+            return;
+        }
+        // TalkBack, like VoiceOver, converts its physical double-tap into one
+        // click activation. One activation therefore completes the shortcut.
+        if (isOtlobliTouchExplorationEnabled()) {
+            otlobliLastHomeActivationAt = 0L;
+            dismissOtlobliStoreSwitchHint();
+            otlobliNavigateHost("store-select");
+            return;
+        }
+
+        long now = SystemClock.uptimeMillis();
+        if (now - otlobliLastHomeActivationAt <= 320L) {
+            otlobliLastHomeActivationAt = 0L;
+            dismissOtlobliStoreSwitchHint();
+            otlobliNavigateHost("store-select");
+        } else {
+            otlobliLastHomeActivationAt = now;
+            showOtlobliStoreSwitchHint();
+        }
+    }
