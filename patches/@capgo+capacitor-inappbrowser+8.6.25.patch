+    private void otlobliClearHumanChallengeNavigationGate() {
+        otlobliHumanChallengeNavigationLocked = false;
+        otlobliHumanChallengeResolutionReported = false;
+        otlobliHumanChallengeDocumentGeneration = "";
+        mainHandler.post(this::updateNavigationButtonsState);
+    }
