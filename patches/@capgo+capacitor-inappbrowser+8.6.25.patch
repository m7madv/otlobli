+    @objc private func otlobliNativeBackButtonDidTap() {
+        guard !otlobliHumanChallengeActive else { return }
+        if otlobliNativeBackTarget == "exit" {
+            emit("messageFromWebview", data: ["detail": ["type": "closeStore"]])
+            return
+        }
+        if otlobliNativeBackTarget == "cart" {
+            emit("messageFromWebview", data: ["detail": ["type": "backToCart"]])
+            return
+        }
+        if otlobliNativeBackTarget == "orders" {
+            emit("messageFromWebview", data: ["detail": ["type": "backToOrders"]])
+            return
+        }
+        guard let webView else { return }
+        if let destination = otlobliNativeBackDestination(in: webView) {
+            webView.go(to: destination)
+        } else if let fallbackURL = otlobliNativeBackFallbackURL {
+            webView.load(URLRequest(url: fallbackURL, cachePolicy: .useProtocolCachePolicy))
+        } else {
+            webView.evaluateJavaScript("var b=document.getElementById('otlobli-back-btn');if(b)b.click()", completionHandler: nil)
+        }
+    }
