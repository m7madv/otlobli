+    private void updateOtlobliNativeNavigationInsets(
+        int opaqueBottomInset,
+        int gestureSafeBottomInset,
+        int safeLeftInset,
+        int safeRightInset,
+        int imeBottomInset,
+        boolean keyboardVisible
+    ) {
+        LinearLayout navigation = otlobliNativeNavigation;
+        View contentBrowserLayout = otlobliNativeNavigationContent;
+        if (navigation == null || contentBrowserLayout == null) return;
+        if (!(navigation.getLayoutParams() instanceof CoordinatorLayout.LayoutParams navigationParams)) return;
+        if (!(contentBrowserLayout.getLayoutParams() instanceof ViewGroup.MarginLayoutParams contentParams)) return;
+
+        // Keep the same 74dp content plus max(16dp, gesture-safe-area) as
+        // React/iOS. An opaque 3-button navigation bar is an outside offset;
+        // a transparent gesture area is padding inside the white surface.
+        // Mixing them used to swallow exactly 16dp on the Note 8.
+        int visibleBottomFloor = keyboardVisible
+            ? otlobliDp(16)
+            : Math.max(otlobliDp(16), Math.max(0, gestureSafeBottomInset));
+        int systemBottomOffset = keyboardVisible ? 0 : Math.max(0, opaqueBottomInset);
+        int keyboardOffset = keyboardVisible ? Math.max(0, imeBottomInset) : 0;
+        int navigationHeight = otlobliDp(74) + visibleBottomFloor;
+        navigation.setPadding(0, 0, 0, visibleBottomFloor);
+        navigationParams.height = navigationHeight;
+        View parent = (View) navigation.getParent();
+        int parentWidth = parent == null ? 0 : parent.getWidth();
+        if (parentWidth <= 0) parentWidth = getContext().getResources().getDisplayMetrics().widthPixels;
+        int appliedSafeLeft = Math.max(0, safeLeftInset);
+        int appliedSafeRight = Math.max(0, safeRightInset);
+        int availableWidth = Math.max(0, parentWidth - appliedSafeLeft - appliedSafeRight);
+        int navigationWidth = Math.min(otlobliDp(440), availableWidth);
+        int centeredGap = Math.max(0, (availableWidth - navigationWidth) / 2);
+        navigationParams.width = navigationWidth;
+        navigationParams.leftMargin = appliedSafeLeft + centeredGap;
+        navigationParams.rightMargin = appliedSafeRight + centeredGap;
+        navigationParams.bottomMargin = systemBottomOffset + keyboardOffset;
+        navigation.setLayoutParams(navigationParams);
+
+        contentParams.height = ViewGroup.LayoutParams.MATCH_PARENT;
+        contentParams.bottomMargin = navigationHeight + systemBottomOffset + keyboardOffset;
+        contentBrowserLayout.setLayoutParams(contentParams);
+        navigation.bringToFront();
+    }
