+    private func retryOtlobliOfflinePage(automatic: Bool) {
+        guard let webView,
+              otlobliOfflineCoverView != nil,
+              !otlobliOfflineRetryInFlight,
+              let retryURL = otlobliOfflineRetryURL ?? webView.url ?? self.url else {
+            return
+        }
+        let now = Date().timeIntervalSince1970
+        if automatic && now - otlobliLastAutomaticRetryAt < 10 {
+            return
+        }
+        if automatic {
+            otlobliLastAutomaticRetryAt = now
+        }
+
+        otlobliOfflineRetryInFlight = true
+        otlobliOfflineNavigationFailed = false
+        otlobliOfflineStatusLabel?.text = "جاري إعادة الاتصال…"
+        otlobliOfflineRetryButton?.isEnabled = false
+        otlobliOfflineRetryButton?.setTitle("جاري المحاولة…", for: .normal)
+        otlobliOfflineRetryButton?.alpha = 0.72
+        webView.stopLoading()
+        webView.load(URLRequest(url: retryURL, cachePolicy: .useProtocolCachePolicy))
+    }
