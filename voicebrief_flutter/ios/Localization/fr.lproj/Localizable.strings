"Done" = "Terminé";
"Voice note saved" = "Message vocal enregistré";
"Open VoiceBrief once after updating to prepare your account for sharing, then share the voice note again." = "Ouvrez VoiceBrief une fois après la mise à jour pour préparer votre compte, puis partagez à nouveau le message.";
