{
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/privacy", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://jyehqpdbayslhzebdycj.supabase.co; form-action https://jyehqpdbayslhzebdycj.supabase.co; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
